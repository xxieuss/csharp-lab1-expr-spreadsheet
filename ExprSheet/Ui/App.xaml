<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ui"
             x:Class="Ui.App">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{x:Static local:Palette.ButtonBg}" />
                <Setter Property="TextColor" Value="{x:Static local:Palette.Text}" />
            </Style>

            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{x:Static local:Palette.Accent}" />
                <Setter Property="TextColor" Value="{x:Static local:Palette.Window}" />
            </Style>

            <Style x:Key="SideButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="BackgroundColor" Value="{x:Static local:Palette.ButtonBg}" />
                <Setter Property="TextColor" Value="{x:Static local:Palette.Text}" />
            </Style>

            <Style x:Key="Separator" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="1" />
                <Setter Property="HeightRequest" Value="20" />
                <Setter Property="Color" Value="{x:Static local:Palette.CardBorder}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Margin" Value="6,0" />
            </Style>

            <Style x:Key="Rule" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{x:Static local:Palette.CardBorder}" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <Style x:Key="Section" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.4" />
                <Setter Property="TextColor" Value="{x:Static local:Palette.TextDim}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{x:Static local:Palette.Card}" />
                <Setter Property="Stroke" Value="{x:Static local:Palette.CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="1.5" />
                <Setter Property="TextColor" Value="{x:Static local:Palette.Text}" />
                <Setter Property="MaximumWidthRequest" Value="820" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
