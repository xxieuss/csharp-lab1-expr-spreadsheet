<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ui"
             x:Class="Ui.HelpPage"
             Title="Довідка"
             BackgroundColor="{x:Static local:Palette.Window}">

    <Grid RowDefinitions="Auto,*" Padding="24,20" RowSpacing="18">

        <HorizontalStackLayout Spacing="8">
            <Button Text="Синтаксис" Clicked="OnSyntax" />
            <Button Text="Операції" Clicked="OnOperations" />
            <Button Text="Мова" Clicked="OnLanguage" />
            <Button Text="Файли" Clicked="OnFiles" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <Label x:Name="TextLabel" Style="{StaticResource Body}" />
        </ScrollView>

    </Grid>
</ContentPage>