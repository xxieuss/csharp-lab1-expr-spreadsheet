<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ui.MainPage"
             Title="Електронна таблиця">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Padding="10" RowSpacing="8">

        <HorizontalStackLayout Grid.Row="0" Spacing="6">
            <Button Text="Нова" Clicked="OnNew" />
            <Button Text="Відкрити" Clicked="OnOpen" />
            <Button Text="Зберегти" Clicked="OnSave" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="6">
            <Button x:Name="ModeButton" Text="Режим: ЗНАЧЕННЯ" Clicked="OnToggleMode" />
            <Button Text="+ рядок" Clicked="OnAddRow" />
            <Button Text="− рядок" Clicked="OnRemoveRow" />
            <Button Text="+ стовпець" Clicked="OnAddColumn" />
            <Button Text="− стовпець" Clicked="OnRemoveColumn" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="2" Spacing="6">
            <Button Text="Дерево розбору" Clicked="OnShowTree" />
            <Button Text="Покрокове обчислення" Clicked="OnShowTrace" />
            <Button Text="Залежності" Clicked="OnShowDependencies" />
            <Button Text="Сховати" Clicked="OnHideInfo" />
        </HorizontalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="70,*" ColumnSpacing="8">
            <Label x:Name="CellNameLabel" FontAttributes="Bold" FontSize="15"
                   VerticalTextAlignment="Center" />
            <Entry x:Name="FormulaEntry" Grid.Column="1"
                   Placeholder="вміст клітинки"
                   Completed="OnFormulaCommitted" />
        </Grid>

        <Label x:Name="ErrorLabel" Grid.Row="4" TextColor="Firebrick" FontSize="13" />

        <ScrollView Grid.Row="5" Orientation="Both">
            <Grid x:Name="SheetGrid" RowSpacing="1" ColumnSpacing="1"
                  BackgroundColor="#999999" />
        </ScrollView>

        <ScrollView x:Name="InfoPanel" Grid.Row="6" IsVisible="False"
                    MaximumHeightRequest="220" BackgroundColor="#F2F2F2">
            <Label x:Name="InfoLabel" Padding="10" FontSize="13"
                   FontFamily="Courier New" TextColor="Black" />
        </ScrollView>

    </Grid>
</ContentPage>