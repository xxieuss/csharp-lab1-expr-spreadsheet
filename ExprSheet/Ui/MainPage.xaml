<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ui.MainPage"
             Title="Електронна таблиця">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Вміст клітинки A1" FontAttributes="Bold" FontSize="16" />

        <HorizontalStackLayout Spacing="8">
            <Entry x:Name="FormulaEntry"
                   Placeholder="наприклад  (2 + 3) * 4 &lt;= 20"
                   WidthRequest="420"
                   Completed="OnCalculate" />
            <Button Text="Обчислити" Clicked="OnCalculate" />
        </HorizontalStackLayout>

        <Label x:Name="ResultLabel" FontSize="18" />
        <Label x:Name="ErrorLabel" TextColor="Firebrick" />
        <Label x:Name="TreeLabel" FontSize="13" />

    </VerticalStackLayout>
</ContentPage>