<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ui"
             x:Class="Ui.MainPage"
             Title="Електронна таблиця"
             BackgroundColor="{x:Static local:Palette.Window}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="18,12"
              BackgroundColor="{x:Static local:Palette.Header}">

            <Label Grid.Column="0" Text="ExprSheet"
                   FontSize="19" FontAttributes="Bold"
                   CharacterSpacing="0.5"
                   TextColor="{x:Static local:Palette.Accent}"
                   VerticalTextAlignment="Center"
                   Margin="0,0,20,0" />

            <ScrollView Grid.Column="1" Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">

                    <Button Text="Нова" Clicked="OnNew" />
                    <Button Text="Відкрити" Clicked="OnOpen" />
                    <Button Text="Зберегти" Clicked="OnSave" />

                    <BoxView Style="{StaticResource Separator}" />

                    <Button Text="+ рядок" Clicked="OnAddRow" />
                    <Button Text="− рядок" Clicked="OnRemoveRow" />
                    <Button Text="+ стовпець" Clicked="OnAddColumn" />
                    <Button Text="− стовпець" Clicked="OnRemoveColumn" />

                    <BoxView Style="{StaticResource Separator}" />

                    <Button x:Name="ValueModeButton" Text="Значення" Clicked="OnValueMode" />
                    <Button x:Name="ExprModeButton" Text="Вирази" Clicked="OnExprMode" />

                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="14" Padding="14">

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="14">

                    <VerticalStackLayout Grid.Row="0" Spacing="8">

                        <Label Text="GOOGLE DRIVE" Style="{StaticResource Section}" />
                        <Button Text="Відкрити з Drive" Style="{StaticResource SideButton}"
                                Clicked="OnDriveOpen" />
                        <Button Text="Зберегти на Drive" Style="{StaticResource SideButton}"
                                Clicked="OnDriveSave" />
                        <Label x:Name="DriveStatusLabel" Text="Не підключено"
                               FontSize="12"
                               TextColor="{x:Static local:Palette.TextDim}" />

                        <BoxView Style="{StaticResource Rule}" Margin="0,6" />

                        <Label Text="РОЗБІР" Style="{StaticResource Section}" />
                        <Button Text="Дерево розбору" Style="{StaticResource SideButton}"
                                Clicked="OnShowTree" />
                        <Button Text="Покрокове обчислення" Style="{StaticResource SideButton}"
                                Clicked="OnShowTrace" />
                        <Button Text="Залежності" Style="{StaticResource SideButton}"
                                Clicked="OnShowDependencies" />

                    </VerticalStackLayout>

                    <Border x:Name="InfoPanel" Grid.Row="1" IsVisible="False"
                            BackgroundColor="{x:Static local:Palette.Cell}"
                            Stroke="{x:Static local:Palette.CardBorder}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6">
                            <Button Grid.Row="0" Text="Сховати" Clicked="OnHideInfo"
                                    HorizontalOptions="End" HeightRequest="26" FontSize="12" />
                            <ScrollView Grid.Row="1" Orientation="Both">
                                <Label x:Name="InfoLabel" FontSize="12" FontFamily="Courier New"
                                       TextColor="{x:Static local:Palette.Text}" />
                            </ScrollView>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="10">

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">

                        <Border Grid.Column="0"
                                BackgroundColor="{x:Static local:Palette.Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,5"
                                VerticalOptions="Center">
                            <Label x:Name="CellNameLabel"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{x:Static local:Palette.Window}"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Label Grid.Column="1" Text="fx"
                               FontSize="14" FontAttributes="Italic"
                               TextColor="{x:Static local:Palette.Accent2}"
                               VerticalTextAlignment="Center" />

                        <Entry x:Name="FormulaEntry" Grid.Column="2"
                               Placeholder="Введіть число або вираз, наприклад: A1 + 5 &lt;= B2, і натисніть Enter"
                               FontSize="14"
                               BackgroundColor="{x:Static local:Palette.Cell}"
                               TextColor="{x:Static local:Palette.Text}"
                               PlaceholderColor="{x:Static local:Palette.TextDim}"
                               Completed="OnFormulaCommitted" />

                        <Button Grid.Column="3" Text="Застосувати"
                                Style="{StaticResource AccentButton}"
                                Clicked="OnApply" />

                        <Button Grid.Column="4" Text="Очистити" Clicked="OnClear" />

                    </Grid>
                </Border>

                <Label x:Name="ErrorLabel" Grid.Row="1" IsVisible="False"
                       FontSize="13" Margin="4,0"
                       TextColor="{x:Static local:Palette.ErrorText}" />

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                    <ScrollView x:Name="GridHost" Orientation="Both" />
                </Border>

            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="18,9"
              BackgroundColor="{x:Static local:Palette.Header}">
            <Label x:Name="StatusLabel" Grid.Column="0"
                   FontSize="12"
                   TextColor="{x:Static local:Palette.TextDim}"
                   VerticalTextAlignment="Center" />
            <Label x:Name="SizeLabel" Grid.Column="1"
                   FontSize="12"
                   TextColor="{x:Static local:Palette.TextDim}"
                   VerticalTextAlignment="Center" />
        </Grid>

    </Grid>
</ContentPage>
